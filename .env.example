# Survey Auto-Tagger — environment template.
#
#   cp .env.example .env    then fill in the secrets (marked CHANGE ME).
#
# Every key is `SURVEY_TAGGER_`-prefixed and maps 1:1 onto a field in
# settings.py, EXCEPT ANTHROPIC_API_KEY, which litellm reads directly.
# Values shown are the code defaults unless noted — commented-out lines are
# already the default and only need uncommenting to override.
#
# NEVER put a real key in this file. It is committed; .gitignore covers
# `.env` but not `.env.example`.


# ── Secrets ─────────────────────────────────────────────────────────
# Read by litellm for every tagging LLM call.
ANTHROPIC_API_KEY=                                  # CHANGE ME
# Parallel.ai, used only by the tenant-profile fetcher.
SURVEY_TAGGER_PARALLEL_API_KEY=                     # CHANGE ME


# ── Data root ───────────────────────────────────────────────────────
# DEPLOYMENT: one share root holding inputs AND generated artifacts:
#
#   {SHARE_ROOT}/{corp_no}/Directory/...                              (in)
#   {SHARE_ROOT}/{corp_no}/tenant_profile/*.json                      (in)
#   {SHARE_ROOT}/{corp_no}/SurveyData/{survey_no}/survey_structure.json  (in)
#   {SHARE_ROOT}/{corp_no}/SurveyData/{survey_no}/tagged_output.json     (OUT)
#   {SHARE_ROOT}/{corp_no}/tenant_tags.json                           (OUT)
#   {SHARE_ROOT}/{corp_no}/tenant_canon_{cx|ex}.json + .embeddings.npz (OUT)
#
# Setting it overrides DATA_DIR and OUTPUT_DIR below, so both roots always
# share a Path anchor (relative_to raises the moment they don't).
#
# Write it UNQUOTED. python-dotenv unicode_escape-decodes double-quoted
# values, which collapses the leading `\\` into a single `\` and silently
# turns the UNC root into a root-relative path. Startup rejects that form.
#   RIGHT: SURVEY_TAGGER_SHARE_ROOT=\\172.16.1.105\sg-int-uc-img\AIChatbot
#   WRONG: SURVEY_TAGGER_SHARE_ROOT="\\172.16.1.105\sg-int-uc-img\AIChatbot"
#
# The service account must have credentials for the share — LocalSystem and
# IIS AppPool identities have none, and nothing in the app authenticates.
#
# When cutting over, delete .cache/survey_hashes.json once. The stored hashes
# still match, so the first run reports every survey as "skipped".
# SURVEY_TAGGER_SHARE_ROOT=\\172.16.1.105\sg-int-uc-img\AIChatbot

# LOCAL DEV — used only when SHARE_ROOT is unset.
SURVEY_TAGGER_DATA_DIR=../extras/data
SURVEY_TAGGER_OUTPUT_DIR=../output

# ALWAYS LOCAL, even in deployment. Holds the LLM response cache,
# survey_hashes.json and global_summary.json — all probed constantly, so a
# network hop here would cost far more than it saves.
SURVEY_TAGGER_CACHE_DIR=../.cache


# ── Pipeline ────────────────────────────────────────────────────────
# Bounded parallelism for per-tenant tagging. 1 = sequential.
SURVEY_TAGGER_MAX_CONCURRENT_SURVEYS=5
# true = deterministic-only mode; no LLM client is built at all.
SURVEY_TAGGER_SKIP_LLM=false


# ── LLM ─────────────────────────────────────────────────────────────
SURVEY_TAGGER_LLM_MODEL=anthropic/claude-sonnet-4-6
SURVEY_TAGGER_LLM_TEMPERATURE=0.1
# 8192 fits the Stage 5 question prompt (+6 fields x up to 80 questions)
# without truncation.
SURVEY_TAGGER_LLM_MAX_TOKENS=8192
SURVEY_TAGGER_LLM_RATE_LIMIT_RPM=50
# Anthropic ephemeral prompt cache on the stable preamble (~90% input token
# saving on a hit).
# SURVEY_TAGGER_LLM_USE_PROMPT_CACHING=true


# ── Canon embeddings (journey_stage / sub_stage_name grounding) ─────
# Local sentence-transformer; downloaded once on first use.
# SURVEY_TAGGER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# SURVEY_TAGGER_EMBEDDING_TOP_K=4
# Below MIN_SCORE a question bypasses the LLM as low_confidence_assigned.
# SURVEY_TAGGER_EMBEDDING_MIN_SCORE=0.35
# SURVEY_TAGGER_EMBEDDING_STRONG_SCORE=0.55


# ── Tenant-profile fetcher (Parallel.ai) ────────────────────────────
# `pro` takes ~10 min per agent; the blocking poll is expected.
# SURVEY_TAGGER_PARALLEL_PROCESSOR=pro
# SURVEY_TAGGER_PARALLEL_API_TIMEOUT=1800
# Each retry is a paid run — keep this low.
SURVEY_TAGGER_PARALLEL_MAX_RETRIES=0


# ── Auto-retag scheduler ────────────────────────────────────────────
# Keep OFF on a share: every scan walks EVERY tenant under the root.
SURVEY_TAGGER_AUTORETAG_ENABLED=false
SURVEY_TAGGER_AUTORETAG_INTERVAL_MINUTES=30
# Force a full re-tag each scan (ignore the change detector).
SURVEY_TAGGER_AUTORETAG_FORCE=false


# ── Logging ─────────────────────────────────────────────────────────
SURVEY_TAGGER_LOG_LEVEL=INFO
SURVEY_TAGGER_LOG_FORMAT=console


# ── JWT auth (parked until product integration) ─────────────────────
# false → the API is open. Flip to true to enforce a Bearer JWT via the
# require_auth dependency in auth.py.
SURVEY_TAGGER_AUTH_ENABLED=false
# SURVEY_TAGGER_JWT_ALGORITHM=RS256
# Defaults to SurveyTagging/keys/public.pem.
# SURVEY_TAGGER_JWT_PUBLIC_KEY_PATH=
# DEV ONLY — treats the Bearer value as a literal corp_no, no signature
# check. MUST stay false outside local dev.
SURVEY_TAGGER_DEV_AUTH_BYPASS=false


# ── SoGo platform (outbound; dormant in v7.0) ───────────────────────
# Set SOGO_HOST to switch environments — both apicx and apipmx URLs derive
# from it. Leave blank for the baked-in intuc default.
#   intuc → sogolyticsintuc.sevenpv.com
#   qauc  → sogoqauc.sogolytics.com
SURVEY_TAGGER_SOGO_HOST=sogolyticsintuc.sevenpv.com
# Explicit overrides win over SOGO_HOST — use these when apicx and apipmx
# live on different hosts.
# SURVEY_TAGGER_SOGO_APICX_BASE_URL=
# SURVEY_TAGGER_SOGO_APIPMX_BASE_URL=
# SURVEY_TAGGER_SOGO_REQUEST_TIMEOUT=30.0
# SURVEY_TAGGER_SOGO_MAX_RETRIES=3
# SURVEY_TAGGER_SOGO_CONCURRENCY=5

# Endpoint paths, captured from intuc's network trace. Only override if a
# future SoGo build moves them.
# SURVEY_TAGGER_SOGO_CATEGORY_CREATE_PATH=/AddEditDeleteCategory/detail/search
# SURVEY_TAGGER_SOGO_BULK_TAG_PATH=/SaveBulkAddEditDelete/detail/search
# SURVEY_TAGGER_SOGO_CUSTOMER_JOURNEY_PATH=/CustomerJourney/detail/search

# Static service token forwarded to apicx when DEV_AUTH_BYPASS=true.
# Empty in production — the caller's verified JWT is forwarded instead.
SURVEY_TAGGER_SOGO_DEV_STATIC_JWT=

# TLS for outbound SoGo calls, in order of preference:
#   1. `pip install truststore` — uses the Windows trust store and picks up
#      corporate CAs automatically. No config needed; cleanest fix for intuc.
#   2. Point at a corporate-CA PEM:
#        SURVEY_TAGGER_SOGO_CA_BUNDLE_PATH=C:/path/to/corporate-root.pem
#   3. Disable verification — intuc dev ONLY, must stay true elsewhere:
#        SURVEY_TAGGER_SOGO_VERIFY_SSL=false
# SURVEY_TAGGER_SOGO_VERIFY_SSL=true
# SURVEY_TAGGER_SOGO_CA_BUNDLE_PATH=
