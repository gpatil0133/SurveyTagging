# Survey Auto-Tagger — environment template.
#
#   cp .env.example .env    then fill in the secrets (marked CHANGE ME).
#
# Every key is `SURVEY_TAGGER_`-prefixed and maps 1:1 onto a field in
# settings.py, EXCEPT the provider API keys, which litellm reads directly.
# Values shown are the code defaults unless the comment says otherwise —
# commented-out lines are already the default and only need uncommenting.
#
# NEVER put a real key in this file. It is committed; .gitignore covers
# `.env` but not `.env.example`.


# Runtime / IIS reverse proxy — see docs/deployment-iis.md
#
# APP_ENV controls the uvicorn binding in run.py. Any value containing "local"
# binds 0.0.0.0 for developer machines. All other values bind SERVER_HOST and
# trust IIS ARR forwarded headers.
# APP_ENV=intuc-live
# SERVER_HOST=127.0.0.1
# API_PORT=8001
#
# The sub-path IIS mounts this app under. Leave it unset when the app owns its
# origin (an IIS site whose root is this app); set it to the virtual path when
# it does not. It mainly governs the URLs the app EMITS: the Swagger server
# list, and the base the UI shell builds its /api and /static URLs from. With it
# wrong the UI 404s its own assets; with it unset behind a virtual path the
# browser falls back to inferring it from the page URL, which is right often
# enough to hide the misconfiguration. Set it explicitly.
#
# SAFE TO LEAVE SET WHEN RUNNING LOCALLY. `python run.py` has no ARR in front of
# it to strip the prefix, so the shell's own asset and API requests used to come
# back 404 and the UI came up blank against a healthy server. run.py's
# PathPrefixMiddleware now strips it as well, so the app answers on BOTH URL
# shapes — http://127.0.0.1:8001/ and http://127.0.0.1:8001/apisurveytagging/
# both work, and this file needs no per-environment edit. Behind ARR the prefix
# is already gone by then and the middleware is a no-op.
#
# Written with or without the leading slash; `API_PATH_PREFIX` is accepted as
# an alias, matching how the stats module spells the same setting.
SURVEY_TAGGER_PATH_PREFIX=/apisurveytagging


# ── Secrets ─────────────────────────────────────────────────────────
# litellm reads the key for whichever provider LLM_MODEL names — set the one
# matching the model below, not both. See the LLM section.
#
# Keep every CHANGE ME on its own comment line, never trailing a value.
# python-dotenv does NOT strip an inline `#` comment from an otherwise-empty
# value: `KEY=   # CHANGE ME` parses as the literal string "# CHANGE ME",
# which is truthy and sails straight past the `if not ...` guards that exist
# to catch an unset key.
#
# CHANGE ME (anthropic/* models)
# ANTHROPIC_API_KEY=
# CHANGE ME (openai/* models)
OPENAI_API_KEY=
# Parallel.ai, used only by the tenant-profile fetcher when
# PROFILE_SOURCE=parallel. Leave blank when PROFILE_SOURCE=smx.
SURVEY_TAGGER_PARALLEL_API_KEY=


# ── Tenant profile source ───────────────────────────────────────────
# Where org/cx/ex profiles come from. The artifacts written to the share
# are identical either way — only the producer differs.
#
#   parallel  this service researches the tenant via Parallel.ai and owns
#             the prompts in tenant_profile/prompts/. Needs the key above
#             and a `website` on the fetch request.
#   smx       read the profile the SoGo Research API already generated
#             (apismx /AIAccountProfile). Same three agents; no key, no
#             website needed. Base URL follows SOGO_HOST below.
SURVEY_TAGGER_PROFILE_SOURCE=smx
# Bearer token for apismx. Leave blank when requests carry their own JWT —
# it is forwarded (shared issuer with auth.py). Required only for headless
# runs (CLI backfill, the auto-retag scheduler) that have no inbound token.
# SURVEY_TAGGER_SMX_TOKEN=
# SURVEY_TAGGER_SMX_REQUEST_TIMEOUT=60.0
#
# Request bodies are encrypted through apipmx /ecdata before they are posted to
# apismx, and sent as raw ciphertext with Content-Type: text/plain. The
# platform's write controllers Base-64 decode the body before parsing it, so a
# plain JSON body comes back as HTTP 500 "input is not a valid Base-64 string".
# Query strings are NOT encrypted, so this only affects calls with a body
# (/AIAccountProfile/Generate) — the GETs are unaffected.
#
# Leave this true. The off switch is for a local stub or an older deploy that
# has not turned request encryption on; off against a real host breaks writes.
# SURVEY_TAGGER_SMX_ENCRYPT_REQUESTS=true
#
# Resolution cascade for smx: the share is checked first, then apismx
# /Details, then /Generate as a last resort. That last step is a WRITE that
# starts paid research — set false to make the fetch look-only.
SURVEY_TAGGER_SMX_ALLOW_GENERATE=true
# How long to wait for a triggered generation before returning "pending".
# Observed: three agents in ~44s. Overrunning is not an error — generation
# continues server-side and the next fetch picks it up from /Details.
# SURVEY_TAGGER_SMX_GENERATE_POLL_ATTEMPTS=6
# SURVEY_TAGGER_SMX_GENERATE_POLL_INTERVAL=15.0
#
# Wire trace for the apismx exchange (tenant_profile/smx_trace.py). OFF:
# successful calls log at DEBUG — invisible at LOG_LEVEL=INFO — and nothing is
# written. ON: every step logs at INFO *and* the full request/response bodies
# land in {LOG_DIR}/smx-wire-YYYY-MM-DD.jsonl, swept on the app.log cutoff.
#
# Failures (HTTP >= 400, a decrypt failure, a non-JSON body) are logged in full
# at ERROR either way — this flag is for seeing what the SUCCESSFUL calls
# returned. Turn it on when a tenant's profile is not what you expect; leave it
# off in steady state, since the JSONL holds whole profile payloads.
# SURVEY_TAGGER_SMX_DEBUG_WIRE=false
# Clipping for the app.log lines only; the JSONL keeps the full body. Floor 200.
# SURVEY_TAGGER_SMX_DEBUG_MAX_CHARS=2000


# ── Data root ───────────────────────────────────────────────────────
# DEPLOYMENT: one share root holding inputs AND generated artifacts:
#
#   {SHARE_ROOT}/{corp_no}/Directory/...                              (in)
#   {SHARE_ROOT}/{corp_no}/tenant_profile/*.json                      (in)
#   {SHARE_ROOT}/{corp_no}/SurveyData/{survey_no}/survey_structure.json  (in)
#   {SHARE_ROOT}/{corp_no}/SurveyData/{survey_no}/tagged_output.json     (OUT)
#   {SHARE_ROOT}/{corp_no}/tenant_tags.json                           (OUT)
#
# Setting it overrides DATA_DIR and OUTPUT_DIR below, so both roots always
# share a Path anchor (relative_to raises the moment they don't).
#
# Accepted form:
#
#   //172.16.1.105/sg-int-uc-img/AIChatbot   UNC. The app speaks SMB itself
#                                            (sharefs.py) with the credentials
#                                            below. Nothing is mounted, so no
#                                            root access is needed.
#
# Prefer forward slashes. The backslash spelling is accepted and normalized,
# but must be UNQUOTED — python-dotenv unicode_escape-decodes double-quoted
# values, collapsing the leading `\\` into a single `\` and silently turning
# the UNC root into a root-relative path. Startup rejects that form.
#   RIGHT: SURVEY_TAGGER_SHARE_ROOT=\\172.16.1.105\sg-int-uc-img\AIChatbot
#   WRONG: SURVEY_TAGGER_SHARE_ROOT="\\172.16.1.105\sg-int-uc-img\AIChatbot"
#
# The service account must have credentials for the share — LocalSystem and
# IIS AppPool identities have none, and nothing in the app authenticates.
#
# When cutting over, delete .cache/survey_hashes.json once. The stored hashes
# still match, so the first run reports every survey as "skipped".
# SURVEY_TAGGER_SHARE_ROOT=//172.16.1.105/sg-int-uc-img/AIChatbot
SURVEY_TAGGER_SHARE_ROOT=//192.168.0.115/sg-qa-uc-img/AIChatbot

# SMB credentials for a UNC SHARE_ROOT. Ignored when SHARE_ROOT is a local path
# or a mount point. Required at startup when it is UNC — the app refuses to
# boot without a user rather than reporting every tenant as missing.
# A domain account is written DOMAIN\user or user@domain. Leave UNQUOTED.
# CHANGE ME — both. An inline `# CHANGE ME` here would parse as a real value
# and let the app boot with a nonsense SMB user (see the Secrets note above).
SURVEY_TAGGER_IMAGE_USER=
SURVEY_TAGGER_IMAGE_PASS=


# LOCAL DEV — used only when SHARE_ROOT is unset.
# SURVEY_TAGGER_DATA_DIR=../extras/data
# SURVEY_TAGGER_OUTPUT_DIR=../output

# ALWAYS LOCAL, even in deployment. Holds the LLM response cache,
# survey_hashes.json and global_summary.json — all probed constantly, so a
# network hop here would cost far more than it saves.
#
# Relative to the process working directory, which is SurveyTagging/ (that is
# where uvicorn is started). Changing this after a run strands the existing
# response cache and survey_hashes.json at the old path — the next run reports
# every survey as changed and re-pays for every LLM call.
SURVEY_TAGGER_CACHE_DIR=.cache


# ── Pipeline ────────────────────────────────────────────────────────
# Bounded parallelism for per-tenant tagging. 1 = sequential.
SURVEY_TAGGER_MAX_CONCURRENT_SURVEYS=5
# true = deterministic-only mode; no LLM client is built at all.
SURVEY_TAGGER_SKIP_LLM=false
# Threads used to probe survey dirs when listing a tenant. Unrelated to
# MAX_CONCURRENT_SURVEYS: no tagging happens here, each thread just waits on
# one SMB round trip. Lower it if the image server complains.
# SURVEY_TAGGER_DISCOVERY_WORKERS=4

# ── LLM ─────────────────────────────────────────────────────────────
# for Anthropic, the model is a Sonnet-4 variant
# SURVEY_TAGGER_LLM_MODEL=anthropic/claude-sonnet-4-6

# For OpenAI, uncomment the line below and comment out the Anthropic model above.
# SURVEY_TAGGER_LLM_MODEL=openai/gpt-5-mini-2025-08-07
SURVEY_TAGGER_LLM_MODEL=openai/gpt-5.1-2025-11-13

# SURVEY_TAGGER_LLM_TEMPERATURE=0.1   # comment when 5 series openai models are to be used
# 8192 fits the Stage 5 question prompt (+6 fields x up to 80 questions)
# without truncation.
SURVEY_TAGGER_LLM_MAX_TOKENS=8192
SURVEY_TAGGER_LLM_RATE_LIMIT_RPM=50
# Anthropic ephemeral prompt cache on the stable preamble (~90% input token
# saving on a hit).
# SURVEY_TAGGER_LLM_USE_PROMPT_CACHING=true


# ── journey_stage / sub_stage_name grounding ────────────────────────
# Nothing to configure. The tenant's journey moments are read from
# tenant_profile/ and inlined into the question prompt whole; the LLM selects
# one by leaf_id. V9 removed the settings that used to live here
# (EMBEDDING_MODEL / EMBEDDING_TOP_K / EMBEDDING_MIN_SCORE /
# EMBEDDING_STRONG_SCORE) along with the sentence-transformers ranker they
# configured, and HF_HUB_OFFLINE with them — there is no model to download,
# cache or run offline any more.


# ── Tenant-profile fetcher (Parallel.ai) ────────────────────────────
# `pro` takes ~10 min per agent; the blocking poll is expected.
# SURVEY_TAGGER_PARALLEL_PROCESSOR=pro
# SURVEY_TAGGER_PARALLEL_API_TIMEOUT=1800
# Each retry is a paid run — keep this low. NOT the code default (1).
SURVEY_TAGGER_PARALLEL_MAX_RETRIES=0


# ── Auto-retag scheduler ────────────────────────────────────────────
# Keep OFF on a share: every scan walks EVERY tenant under the root.
SURVEY_TAGGER_AUTORETAG_ENABLED=false
SURVEY_TAGGER_AUTORETAG_INTERVAL_MINUTES=30
# Force a full re-tag each scan (ignore the change detector).
SURVEY_TAGGER_AUTORETAG_FORCE=false


# ── Logging & usage ledger ──────────────────────────────────────────
# NOT the code default (DEBUG) — DEBUG is unreadable here, since smbprotocol
# narrates every SMB open/close.
SURVEY_TAGGER_LOG_LEVEL=INFO
SURVEY_TAGGER_LOG_FORMAT=console

# All sinks live here. Keep it LOCAL for the same reason CACHE_DIR is local —
# these are written on every request and every survey.
#   {LOG_DIR}/app.log                     rotating text log (app + uvicorn access)
#   {LOG_DIR}/usage-YYYY-MM-DD.jsonl      cost/latency ledger, one JSON per line
#   {LOG_DIR}/smx-wire-YYYY-MM-DD.jsonl   apismx wire trace, only when
#                                         SMX_DEBUG_WIRE=true
SURVEY_TAGGER_LOG_DIR=./logs
SURVEY_TAGGER_USAGE_LOG_ENABLED=true
SURVEY_TAGGER_APP_LOG_MAX_BYTES=10485760
SURVEY_TAGGER_APP_LOG_BACKUP_COUNT=10
# false under a service host where stderr goes nowhere.
SURVEY_TAGGER_LOG_TO_STDERR=true

# Retention bounds the PILE; rotation above bounds one file. Both sinks need
# both — the ledger and the wire trace are one new file per UTC day, so without
# this they grow unbounded. 0 disables the sweep for that sink; the live
# app.log and today's files are never deleted. smx-wire-* expires on the
# app.log cutoff (a debug artifact, not a billing record).
SURVEY_TAGGER_APP_LOG_RETENTION_DAYS=30
SURVEY_TAGGER_USAGE_LOG_RETENTION_DAYS=90

# Cost accounting falls back to these only when litellm cannot price the model
# (negotiated rate, self-hosted endpoint, or a model newer than the installed
# litellm). 0.0 = trust litellm's price map. USD per million tokens.
SURVEY_TAGGER_LLM_PRICE_INPUT_PER_MTOK=0.0
SURVEY_TAGGER_LLM_PRICE_OUTPUT_PER_MTOK=0.0


# ── JWT auth (parked until product integration) ─────────────────────
# false → the API is open. Flip to true to enforce a Bearer JWT via the
# require_auth dependency in auth.py.
SURVEY_TAGGER_AUTH_ENABLED=false
# SURVEY_TAGGER_JWT_ALGORITHM=RS256
# Defaults to SurveyTagging/keys/public.pem.
# SURVEY_TAGGER_JWT_PUBLIC_KEY_PATH=
# DEV ONLY — treats the Bearer value as a literal corp_no, no signature
# check. MUST stay false outside local dev.
SURVEY_TAGGER_DEV_AUTH_BYPASS=false

# optional — only needed for headless paths (scheduler/CLI) with no inbound JWT:
# SURVEY_TAGGER_SMX_TOKEN=
# only if apismx isn't on the default host:
SURVEY_TAGGER_SOGO_APISMX_BASE_URL=https://sogoqauc.sogolytics.com/apismx


# ── SoGo platform (outbound) ────────────────────────────────────────
# Set SOGO_HOST to switch environments — the apicx, apipmx AND apismx URLs
# all derive from it. Leave blank for the baked-in intuc default.
#   intuc → sogolyticsintuc.sevenpv.com
#   qauc  → sogoqauc.sogolytics.com
SURVEY_TAGGER_SOGO_HOST=sogolyticsintuc.sevenpv.com
# Explicit overrides win over SOGO_HOST — use these when the services
# live on different hosts. apismx and apipmx must stay on the same host:
# apipmx /ecdata encrypts what we send and /dcdata decrypts what comes back,
# so a mismatched pair yields ciphertext the target host cannot read.
# SURVEY_TAGGER_SOGO_APICX_BASE_URL=
# SURVEY_TAGGER_SOGO_APIPMX_BASE_URL=
# SURVEY_TAGGER_SOGO_APISMX_BASE_URL=
# SURVEY_TAGGER_SOGO_REQUEST_TIMEOUT=30.0
# SURVEY_TAGGER_SOGO_MAX_RETRIES=3
# SURVEY_TAGGER_SOGO_CONCURRENCY=5

# Endpoint paths, captured from intuc's network trace. Only override if a
# future SoGo build moves them.
# SURVEY_TAGGER_SOGO_CATEGORY_CREATE_PATH=/AddEditDeleteCategory/detail/search
# SURVEY_TAGGER_SOGO_BULK_TAG_PATH=/SaveBulkAddEditDelete/detail/search
# SURVEY_TAGGER_SOGO_CUSTOMER_JOURNEY_PATH=/CustomerJourney/detail/search

# Static service token forwarded to apicx when DEV_AUTH_BYPASS=true.
# Empty in production — the caller's verified JWT is forwarded instead.
# SURVEY_TAGGER_SOGO_DEV_STATIC_JWT=

# TLS for outbound SoGo calls, in order of preference:
#   1. Leave both settings below alone. The app installs `truststore` at
#      startup (tls_trust.py), so verification goes through the Windows trust
#      store and picks up corporate CAs automatically — no config needed, and
#      the right answer for intuc. `truststore` is already a dependency.
#      If you see "unable to get local issuer certificate", check the startup
#      log for `tls_truststore_installed` before touching anything here.
#   2. Point at a corporate-CA PEM:
#        SURVEY_TAGGER_SOGO_CA_BUNDLE_PATH=C:/path/to/corporate-root.pem
#   3. Disable verification — intuc dev ONLY, must stay true elsewhere:
#        SURVEY_TAGGER_SOGO_VERIFY_SSL=false
# SURVEY_TAGGER_SOGO_VERIFY_SSL=true
# SURVEY_TAGGER_SOGO_CA_BUNDLE_PATH=
