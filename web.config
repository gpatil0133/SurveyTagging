<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="UrlRewriter" />
    </modules>
    <rewrite>
      <rules>
        <!-- Everything goes to uvicorn. FastAPI serves /static and / from the static/ folder. -->
        <rule name="ReverseProxyToSurveyTagging" stopProcessing="true">
          <match url="^(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/x-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/x-woff2" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
    </staticContent>
    <!-- No CORS headers here. FastAPI's CORSMiddleware already sends them for
         every proxied response, and two Access-Control-Allow-Origin headers on
         one response is not "belt and braces" — the browser rejects the
         duplicate outright and every cross-origin call fails. IIS also cannot
         see the app's route table: the list here was GET,POST,OPTIONS while the
         API serves DELETE. One owner, and it is the app. -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
